# Frontend environment (Vite). Copy to `.env.local` for local overrides.
# The API base path is proxied by Vite in development and must stay relative in production builds.
VITE_API_BASE_URL=/api/v1
# Optional: where the dev server proxies /api (defaults to the FastAPI dev server).
VITE_PROXY_TARGET=http://127.0.0.1:8000
