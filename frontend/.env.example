# Frontend environment (Vite). Copy to `.env.local` for local overrides.
# Local development: Vite proxies this relative path to VITE_PROXY_TARGET.
# A Vercel build must override it with an absolute https://<backend>/api/v1 URL.
VITE_API_BASE_URL=/api/v1
# Optional: where the dev server proxies /api (defaults to the FastAPI dev server).
VITE_PROXY_TARGET=http://127.0.0.1:8000
