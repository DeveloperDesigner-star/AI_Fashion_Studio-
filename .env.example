# =============================================================================
# AI FASHION STUDIO — environment template
# Copy to `.env` (backend reads ../.env and backend/.env) and fill in values.
# NEVER commit a real .env file. All secrets stay server-side.
# =============================================================================

# ---- Application ----
APP_NAME="AI Fashion Studio"
APP_ENV=development            # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
# Comma separated exact browser origins allowed to call the API. No wildcard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# OpenAPI/Redoc by default. Set false to hide /docs, /redoc and /openapi.json.
API_DOCS_ENABLED=true
# Trust X-Forwarded-For only behind a proxy that overwrites it (nginx/Render).
# Vercel is detected automatically via VERCEL=1.
TRUST_PROXY_HEADERS=false
# Public base URL of the API (used in generated links / docs).
PUBLIC_API_URL=http://localhost:8000

# ---- Security ----
# REQUIRED in production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_MIN_LENGTH=10
# Set to true behind HTTPS so refresh cookies are Secure.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- Database ----
# PostgreSQL is the supported production database.
# docker compose requires POSTGRES_PASSWORD (used to build the DB URL); use a URL-safe random value.
POSTGRES_PASSWORD=change-me-database-password
DATABASE_URL=postgresql+psycopg2://fashion:change-me-database-password@localhost:5432/fashion_studio
# Zero-config local fallback (used by tests and quick starts):
# DATABASE_URL=sqlite:///./var/fashion_studio.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Applied to every PostgreSQL connection (including Alembic) when absent.
DB_CONNECT_TIMEOUT_SECONDS=10
# Optional libpq sslmode. Supabase hosts default to "require".
DB_SSL_MODE=
# Set true on Vercel/other serverless hosts (also auto-detected on VERCEL=1 or
# a Supabase transaction-pooler URL on port 6543).
DB_USE_NULL_POOL=false
# Supabase transaction pooler URI for the API (port 6543). Migrations should use
# the session pooler/direct URI instead; see docs/SUPABASE.md.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# ---- Supabase (PostgreSQL + private Storage) ----
# Project URL only; no trailing slash.
SUPABASE_URL=
# Public client key. Kept for future Supabase JS work; the backend never uses it
# as a database password and it grants no access to private storage.
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_... / legacy service_role). Required only
# when MEDIA_STORAGE=supabase. NEVER put this in a VITE_* variable or GitHub.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=media
# local = filesystem (development); supabase = private Supabase Storage.
MEDIA_STORAGE=local
SUPABASE_TIMEOUT_SECONDS=30

# ---- Uploads ----
# On Vercel use /tmp/uploads (ephemeral cache); Supabase Storage is the durable copy.
MEDIA_ROOT=./var/uploads
# Vercel functions accept at most ~4.5 MB per request; use 4 there.
MAX_UPLOAD_MB=8
MAX_IMAGE_PIXELS=24000000
# Uploaded files are private-by-default; served through an authenticated endpoint.
UPLOAD_RETENTION_DAYS=90

# ---- Virtual try-on (CatVTON GPU worker) ----
# Leave empty to show an explicit unavailable state. Never put this token in
# frontend build variables.
TRYON_REMOTE_URL=
TRYON_REMOTE_TOKEN=
TRYON_REQUEST_TIMEOUT=240
TRYON_HEALTH_TIMEOUT=4
TRYON_MAX_RESULT_MB=20
TRYON_RATE_LIMIT_PER_MINUTE=4

# ---- Self-hosted CatVTON GPU worker (docker compose --profile tryon) ----
# The worker refuses to start without a token. Set this and TRYON_REMOTE_TOKEN
# to the same long random value; never expose either to the browser.
TRYON_WORKER_TOKEN=
CATVTON_VERSION=mix
# bf16 needs Ampere or newer; use fp16 on older GPUs.
CATVTON_PRECISION=bf16
# Optional pre-downloaded Hugging Face snapshot for offline hosts.
CATVTON_MODELS_DIR=

# ---- AI providers (all optional; the app degrades gracefully) ----
# Primary: Google Gemini (free tier available) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
# Secondary: Groq (free tier available) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# Third: OpenAI — DISABLED BY DEFAULT. Opt-in only, may incur cost.
OPENAI_API_KEY=
OPENAI_ENABLED=false
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
# Second paid gate: OpenAI stays inert unless BOTH OPENAI_ENABLED and this are true.
AI_PAID_USAGE_ENABLED=false
# Provider request timeout (seconds) and daily fair-use quotas per user.
AI_REQUEST_TIMEOUT=45
AI_DAILY_REQUEST_LIMIT=40
AI_DAILY_TOKEN_LIMIT=120000
AI_MAX_PROMPT_CHARS=6000
# Default fallback chain (administrators can persist a different order in /admin).
AI_PROVIDER_ORDER=gemini,groq,openai
# Hard ceiling on upstream attempts per user request and optional retries inside a provider.
AI_MAX_PROVIDER_ATTEMPTS=3
AI_PROVIDER_RETRIES=0
AI_RETRY_BACKOFF_SECONDS=0.35
AI_LOG_RETENTION_DAYS=30

# ---- Fair-use technical limits (protect free infrastructure) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=90
AUTH_RATE_LIMIT_PER_MINUTE=12
UPLOAD_RATE_LIMIT_PER_MINUTE=20
MAX_DESIGNS_PER_USER=200
MAX_OUTFITS_PER_USER=100
MAX_UPLOADS_PER_USER=500

# ---- Frontend (Vite build-time, see frontend/.env.example) ----
VITE_API_BASE_URL=/api/v1
